  },
  "Seed": {
    "AdminEmail": "admin@taskmanager.local",
    "AdminPassword": "Admin@12345"
  },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "RateLimiting": { "LoginPerMinute": 10 },
  "AllowedHosts": "*"
}
