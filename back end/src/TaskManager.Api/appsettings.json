{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": { "IncludeScopes": true }

  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=taskmanager;Username=taskmanager;Password=taskmanager_dev",
    "Redis": "localhost:6379"
  },
  "Worker": {
    "ProcessingDelaySeconds": 5,
    "MaxConcurrency": 4
  },
